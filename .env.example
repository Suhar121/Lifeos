# ============================================================
# LifeOS — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ---------- Database ----------
# SQLite (local dev):
DATABASE_URL=sqlite:///./lifeos.db
# PostgreSQL (production / Docker):
# DATABASE_URL=postgresql://lifeos_user:password@db:5432/lifeos_db

# ---------- Authentication ----------
# CHANGE this in production — used to sign JWT tokens
SECRET_KEY=your-secret-key-change-this-in-production

# ---------- Server ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- CORS ----------
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://lifebuddy.dpdns.org

# ---------- Firebase (Push Notifications) ----------
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ---------- App URL ----------
# Base URL used in push-notification deep links
APP_BASE_URL=https://lifebuddy.dpdns.org

# ---------- OpenAI (optional — AI insights) ----------
# OPENAI_API_KEY=sk-your-openai-key-here

# ---------- WhatsApp (optional — medicine alerts) ----------
# Facebook Graph API v22.0 — sends missed-medicine alerts to caretakers
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
WHATSAPP_TOKEN=your-whatsapp-access-token

# ---------- Environment ----------
ENVIRONMENT=development
