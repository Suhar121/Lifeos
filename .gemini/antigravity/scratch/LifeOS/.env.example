# Backend Environment Variables

# Database
DATABASE_URL=sqlite:///./lifeos.db
# DATABASE_URL=postgresql://lifeos_user:password@localhost:5432/lifeos_db

# JWT Secret (change in production!)
SECRET_KEY=your-secret-key-change-this-in-production

# OpenAI API Key (for AI features)
# OPENAI_API_KEY=sk-your-openai-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://lifebuddy.dpdns.org

# VAPID Keys for Web Push Notifications (base64url raw format)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIM_EMAIL=mailto:you@example.com

# WhatsApp (Facebook Graph API) - for medicine alerts to caretakers
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
WHATSAPP_TOKEN=your-whatsapp-access-token

# Environment
ENVIRONMENT=development
